$ 10. OBSTACLE — sub-grid obstacles (dams, breakwaters, quays)
$ ============================================================================
{% if obstacles is defined %}
{% for o in obstacles %}
{% set trans = o.transmission | upper %}
{% if trans == "TRANS1D" %}
OBSTACLE TRANS1D{% for c in o.trcoef %} {{ c }}{% endfor %} &
{% elif trans == "TRANS2D" %}
OBSTACLE TRANS2D{% for c in o.trcoef %} {{ c }}{% endfor %} &
{% elif trans == "DAM" %}
{% set dtype = o.dam_type | upper %}
{% if dtype == "GODA" %}
OBSTACLE DAM GODA {{ o.hgt }} {{ o.alpha }} {{ o.beta }} &
{% elif dtype == "DANGREMOND" %}
OBSTACLE DAM DANGREMOND {{ o.hgt }} {{ o.slope }} {{ o.bk }} &
{% endif %}
{% elif trans == "FIG" %}
OBSTACLE FIG {{ o.alpha1 }} {{ o.hss }} {{ o.tss }} {{ o.dss }} {{ o.dd }} {{ o.minfr }} {{ o.shape }} &
{% endif %}
{% if o.reflec is defined %}
    REFLEC {{ o.reflec }}{% if o.reflec_type is defined %} {{ o.reflec_type }}{% if o.reflec_type|upper == "RDIFF" and o.reflec_pown is defined %} {{ o.reflec_pown }}{% endif %}{% endif %} &
{% endif %}
{% if o.freeboard_hgt is defined %}
    FREEBOARD {{ o.freeboard_hgt }} {{ o.freeboard_gammat | default(1.0, true) }} {{ o.freeboard_gammar | default(1.0, true) }}{% if o.freeboard_quay %} QUAY{% endif %} &
{% endif %}
    LINE{% for pt in o.line %} {{ pt.x }} {{ pt.y }}{% endfor %}

{% endfor %}
{% endif %}


