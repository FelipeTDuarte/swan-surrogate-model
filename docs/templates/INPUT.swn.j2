$ ============================================================================
$ INPUT.swn.j2
$
$ SNL-SWAN input deck — generated automatically by 03_build_swan_inputs.py
$ problem_id : {{ problem_id }}
$ layout_id  : {{ layout_id }}
$ family     : {{ family }}
$ sea_state  : {{ sea_state_id }}   Hs={{ Hs }} m   Tp={{ Tp }} s   Dir={{ Dir }} deg
$
$ Do not edit generated files by hand — edit this template and re-run the
$ build script instead.
$ ============================================================================


$ ============================================================================
$ 1. PROJECT
$ ============================================================================
PROJECT '{{ problem_id }}' '{{ run_id }}'
{% if title1 is defined %}    '{{ title1 }}'
{% endif %}
{%- if title2 is defined %}    '{{ title2 }}'
{% endif %}
{%- if title3 is defined %}    '{{ title3 }}'
{% endif %}


$ ============================================================================
$ 2. SET
$ ============================================================================
SET     LEVEL = {{ LEVEL | default("0.00") }} NOR =  {{ NOR | default("90.00") }}               &
        DEPMIN = {{ DEPMIN | default("0.05") }} MAXMES =  {{ MAXMES | default("200") }}         &
        MAXERR = {{ MAXERR | default("2") }} GRAV =   {{ GRAV | default("9.81") }}              &
        RHO =  {{ RHO | default("1025.00") }} CDCAP = {{ CDCAP | default("99999") }}        &
        INRHOG =   {{ INRHOG | default("1") }} HSRERR = {{ HSRERR | default("0.10") }}          &
        {{ COORD_CONVENTION | default("CARTESIAN") }} PWTail = {{ PWTail | default("4") }}       &
        FROUDMAX = {{ FROUDMAX | default("0.08") }} ICEWIND = {{ ICEWIND | default("0.00") }}   &
        EXCMARK = {{ EXCMARK | default("999") }}

{% if obcase is defined %}
SET OBCASE = {{ obcase }}
{% endif %}


$ ============================================================================
$ 3. MODE
$ ============================================================================
MODE {{ mode | default("STATIONARY") }} {{ dimentions | default("TWODIMENSIONAL") }}


$ ============================================================================
$ 4. COORDINATES
$ ============================================================================
COORDINATES {{ coordinate_system | default("CARTESIAN") }} & 
{% if coordinate_system == "SPHERICAL" %} projection {{ projection | default("CCM") }} {% endif %} &    
{% if repeating == "on" %} REPEATING {% endif %} &


$ ============================================================================
$ 5. CGRID — computational grid
$ ============================================================================
{% if grid_type == "UNSTRUCTURED" %}
CGRID UNSTRUCTURED {{ spectral_direction | default("CIRCLE") }} {% if spectral_direction == "SECTOR" %}
    {{ sector_angle1 }} {{ sector_angle2 }} {% endif %} &
    {{ mdc }} {{ flow }} {{ fhigh }} {{ msc }}
READGRID UNSTRUCTURED {{ grid_method | default("ADCIRC") }} & 
    {% if grid_method == "TRIAGLE" or grid_method == "EASYMESH" %} '{{ grid_file }}' {% endif%}
{% elif grid_type == "CURVILINEAR" %}
CGRID CURVILINEAR {{ mxc }} {{ myc }} &
    EXCEPT {{ curv_exc_x | default(0.0) }} {{ curv_exc_y | default(0.0) }}  &
    {{ spectral_direction | default("CIRCLE") }} {% if spectral_direction == "SECTOR" %} &
    {{ sector_angle1 }} {{ sector_angle2 }} {% endif %} &
    {{ mdc }} {{ flow }} {{ fhigh }} {{ msc }}
READGRID COORDINATES 1 '{{ grid_file }}' {{ IDLA | default("4") }} {{NHEDF | default("0") }} {{NHEDVEC | default("0") }} {{ grid_read_method | default("FREE") }} &
                     {% if spectral_direction == "FORMAT" %} {{ format_file }} {% endif %}
{% else %}
CGRID REGULAR {{ xpc }} {{ ypc }} {{ alpc | default(0.0) }} {{ xlenc }} {{ ylenc }} {{ mxc }} {{ myc }} 
    {{ spectral_direction | default("CIRCLE") }} {% if spectral_direction == "SECTOR" %} 
    {{ sector_angle1 }} {{ sector_angle2 }} {% endif %} {{ mdc }} {{ flow }} {{ fhigh }} {{ msc }}
{% endif %}


$ ============================================================================
$ 6. INPGRID / READINP — one block per input field (bathymetry is required;
$    all others — wind, current, water level, friction, turbulence, mud,
$    ice, spectral partitions — are optional and only appear if declared
$    in swan.yaml under `input_fields`).
$ ============================================================================
{% macro inpgrid_block(kind, gtype, xpinp, ypinp, alpinp, mxinp, myinp, dxinp, dyinp,
                        stagrx, stagry, excval, nonstat, tbeginp, deltinp, delt_unit, tendinp,
                        fname, fac, idla, nhedf, fmt) %}
{% set gtype_u = gtype | upper %}
{% if gtype_u == "REGULAR" %}
INPGRID {{ kind }} REGULAR {{ xpinp }} {{ ypinp }} {{ alpinp | default(0.0, true) }} {{ mxinp }} {{ myinp }} {{ dxinp }} {{ dyinp }}{% if excval is defined and excval is not none %} &
    EXCEPTION {{ excval }}{% endif %}{% if nonstat %} &
    NONSTATIONARY {{ tbeginp }} {{ deltinp }} {{ delt_unit | default("HR", true) }} {{ tendinp }}{% endif %}
{% elif gtype_u == "CURVILINEAR" %}
INPGRID {{ kind }} CURVILINEAR {{ stagrx | default(0, true) }} {{ stagry | default(0, true) }} {{ mxinp }} {{ myinp }}{% if excval is defined and excval is not none %} &
    EXCEPTION {{ excval }}{% endif %}{% if nonstat %} &
    NONSTATIONARY {{ tbeginp }} {{ deltinp }} {{ delt_unit | default("HR", true) }} {{ tendinp }}{% endif %}
{% elif gtype_u == "UNSTRUCTURED" %}
INPGRID {{ kind }} UNSTRUCTURED{% if excval is defined and excval is not none %} EXCEPTION {{ excval }}{% endif %}{% if nonstat %} &
    NONSTATIONARY {{ tbeginp }} {{ deltinp }} {{ delt_unit | default("HR", true) }} {{ tendinp }}{% endif %}
{% endif %}

READINP {{ kind }} {{ fac | default(1.0, true) }} '{{ fname }}' {{ idla | default(3, true) }}{% if nhedf is defined and nhedf is not none %} {{ nhedf }}{% endif %} {{ fmt | default("FREE", true) }}
{% endmacro %}
{{ inpgrid_block("BOTTOM", grid_type, xpc, ypc, alpc, mxc, myc, dxinp, dyinp,
                  none, none, exc_value, false, none, none, none, none,
                  bottom_file, 1.0, 3, none, "FREE") }}
{% if input_fields is defined %}
{% for f in input_fields %}
{{ inpgrid_block(f.kind, f.grid_type | default(grid_type), f.get("xpinp", xpc), f.get("ypinp", ypc),
                  f.get("alpinp", alpc), f.get("mxinp", mxc), f.get("myinp", myc),
                  f.get("dxinp", dxinp), f.get("dyinp", dyinp),
                  f.get("stagrx"), f.get("stagry"), f.get("exc_value"), f.get("nonstationary", false),
                  f.get("tbeginp"), f.get("deltinp"), f.get("delt_unit"), f.get("tendinp"),
                  f.file, f.get("fac", 1.0), f.get("idla", 3), f.get("nhedf"), f.get("fmt", "FREE")) }}
{% endfor %}
{% endif %}
{% if wind_vel is defined %}
WIND {{ wind_vel }} {{ wind_dir }}
{% endif %}
{% if ice_aice is defined %}
ICE {{ ice_aice }} {{ ice_hice }}
{% endif %}

$ ============================================================================
$ 7. BOUNDARY CONDITIONS
$ ============================================================================

{% macro shapespec_line(shape, gamma, sigfr, d, peak_mean, dspr_mode) %}
{% set shape_u = (shape | default("JONSWAP")) | upper %}
{% if shape_u == "JONSWAP" %}
BOUN SHAPE JONSWAP{% if gamma is defined %}   {{ gamma }}{% endif %} {{ peak_mean | default("PEAK", true) }} DSPR {{ dspr_mode | default("POWER", true) }}
{% elif shape_u == "PM" %}
BOUN SHAPE PM {{ peak_mean | default("PEAK", true) }} DSPR {{ dspr_mode | default("POWER", true) }}
{% elif shape_u == "GAUSS" %}
BOUN SHAPE GAUSS{% if sigfr is defined %}   {{ sigfr }}{% endif %} {{ peak_mean | default("PEAK", true) }} DSPR {{ dspr_mode | default("POWER", true) }}
{% elif shape_u == "BIN" %}
BOUN SHAPE BIN {{ peak_mean | default("PEAK", true) }} DSPR {{ dspr_mode | default("POWER", true) }}
{% elif shape_u == "TMA" %}
BOUN SHAPE TMA{% if gamma is defined %}   {{ gamma }}{% endif %}{% if d is defined %}   {{ d }}{% endif %} {{ peak_mean | default("PEAK", true) }} DSPR {{ dspr_mode | default("POWER", true) }}
{% endif %}
{% endmacro %}

{% if boundary_mode == "segment_file" %}
BOUNDSPEC SEGMENT XY{% for pt in bnd_points %} {{ pt.x }} {{ pt.y }}{% endfor %} &
    {{ boundary_kind | default("VAR", true) }} FILE {{ bnd_len | default(1) }} '{{ boundary_file }}'{% if bnd_seq is defined %} {{ bnd_seq }}{% endif %}
{% elif boundary_mode == "segment_par" %}
BOUNDSPEC SEGMENT XY{% for pt in bnd_points %} {{ pt.x }} {{ pt.y }}{% endfor %} &
    {{ boundary_kind | default("CON", true) }} PAR{% for p in bnd_par_sets %} {% if boundary_kind in ("VAR", "VARIABLE") %}{{ p.len }} {% endif %}{{ p.hs }} {{ p.per }} {{ p.dir }}{% if p.dd is defined %} {{ p.dd }}{% endif %}{% endfor %}
{% elif boundary_mode == "nest" %}
BOUNDNEST1 NEST '{{ nest_file }}' {{ nest_mode | default("CLOSED", true) }}
{% elif boundary_mode == "wamnest" %}
BOUNDNEST2 WAMNEST '{{ nest_file }}' {{ nest_fmt | default("FREE", true) }}{% if xgc is defined %} {{ xgc }} {{ ygc }}{% endif %}{% if lwdate is defined %} {{ lwdate }}{% endif %}
{% elif boundary_mode == "ww3nest" %}
BOUNDNEST3 WW3 '{{ nest_file }}' {{ nest_fmt | default("FREE", true) }} {{ nest_open_close | default("CLOSED", true) }}{% if xgc is defined %} {{ xgc }} {{ ygc }}{% endif %}
{% else %}
{% if boundary_sides is defined %}
{% for b in boundary_sides %}
{{ shapespec_line(b.shape, b.get("gamma", jonswap_gamma), b.get("sigfr"), b.get("d"), b.get("peak_mean"), b.get("dspr_mode")) }}
BOUN SIDE {{ b.side }}{% if b.k is defined %} {{ b.k }}{% endif %}  {{ b.get("rotation", "CCW") }}     &
                    {{ b.get("boundary_kind", "CON") }}  PAR     {{ b.get("hs", Hs) }}   {{ b.get("per", Tp) }}  {{ b.get("dir", Dir) }}{% if b.dd is defined %}    {{ b.dd }}{% elif dspr is defined %}    {{ dspr }}{% endif %}

{% endfor %}
{% else %}
{{ shapespec_line(shape, jonswap_gamma, sigfr, d, peak_mean, dspr_mode) }}
BOUN SIDE {{ boundary_side | default("W") }}{% if boundary_k is defined %} {{ boundary_k }}{% endif %}  {{ boundary_rotation | default("CCW", true) }}     &
                    {{ boundary_kind | default("CON", true) }}  PAR     {{ Hs }}   {{ Tp }}  {{ Dir }}{% if dspr is defined %}    {{ dspr }}{% endif %}
{% endif %}
{% endif %}

