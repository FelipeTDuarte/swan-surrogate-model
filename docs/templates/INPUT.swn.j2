{% for loc in locations %}
{% if loc.type == "FRAME" %}
FRAME '{{ loc.sname }}' {{ loc.xpfr }} {{ loc.ypfr }} {{ loc.alpfr }} {{ loc.xlenfr }} {{ loc.ylenfr }} {{ loc.mxfr }} {{ loc.myfr }}
{% elif loc.type == "GROUP" %}
GROUP '{{ loc.sname }}' SUBGRID {{ loc.ix1 }} {{ loc.ix2 }} {{ loc.iy1 }} {{ loc.iy2 }}
{% elif loc.type == "CURVE" %}
CURVE '{{ loc.sname }}' {{ loc.xp1 }} {{ loc.yp1 }}{% for s in loc.segments | default([], true) %} {{ s.int }} {{ s.xp }} {{ s.yp }}{% endfor %}

{% elif loc.type == "RAY" %}
RAY '{{ loc.rname }}' {{ loc.xp1 }} {{ loc.yp1 }} {{ loc.xq1 }} {{ loc.yq1 }}{% for s in loc.segments | default([], true) %} {{ s.int }} {{ s.xp }} {{ s.yp }} {{ s.xq }} {{ s.yq }}{% endfor %}

{% elif loc.type == "ISOLINE" %}
ISOLINE '{{ loc.sname }}' '{{ loc.rname }}' {{ loc.kind | default("DEPTH", true) }} {{ loc.dep }}
{% elif loc.type == "POINTS" %}
{% if loc.file is defined %}
POINTS '{{ loc.sname }}' FILE '{{ loc.file }}'

{% else %}
POINTS '{{ loc.sname }}'{% for pt in loc.points %} {{ pt.xp }} {{ pt.yp }}{% endfor %}

{% endif %}
{% elif loc.type == "NGRID" %}
{% if loc.mode == "UNSTRUCTURED" %}
NGRID '{{ loc.sname }}' UNSTRUCTURED {{ loc.mesher | default("TRIANGLE", true) }} '{{ loc.file }}'
{% else %}
NGRID '{{ loc.sname }}' {{ loc.xpn }} {{ loc.ypn }} {{ loc.alpn }} {{ loc.xlenn }} {{ loc.ylenn }} {{ loc.mxn }} {{ loc.myn }}
{% endif %}
{% endif %}
{% endfor %}
{% endif %}


{% if output_options_comment is defined %}
OUTPUT OPTIONS '{{ output_options_comment }}'{% if output_options_table_field is defined %} TABLE {{ output_options_table_field }}{% endif %}{% if output_options_block_ndec is defined %} BLOCK {{ output_options_block_ndec }} {{ output_options_block_len }}{% endif %}{% if output_options_spec_ndec is defined %} SPEC {{ output_options_spec_ndec }}{% endif %}
{% endif %}


{% if requests is defined %}
{% for r in requests %}
{% if r.type == "BLOCK" %}
BLOCK '{{ r.location }}' {{ "HEADER" if r.header else "NOHEADER" }} '{{ r.file }}'{% if r.idla is defined %} LAY-OUT {{ r.idla }}{% endif %} &
    {% for q in r.quantities %}{{ q }} {% endfor %}{% if r.unit is defined %}{{ r.unit }}{% endif %}{% if r.nonstationary %} &
    OUTPUT {{ r.tbeg }} {{ r.delt }} {{ r.delt_unit | default("HR", true) }}{% endif %}

{% elif r.type == "TABLE" %}
TABLE '{{ r.location }}' {{ r.header | default("HEADER", true) }} '{{ r.file }}' &
    {% for q in r.quantities %}{{ q }} {% endfor %}{% if r.unit is defined %}{{ r.unit }}{% endif %}{% if r.nonstationary %} &
    OUTPUT {{ r.tbeg }} {{ r.delt }} {{ r.delt_unit | default("HR", true) }}{% endif %}

{% elif r.type == "SPECOUT" %}
SPECOUT '{{ r.location }}' {{ r.spec_dim | default("SPEC2D", true) }} {{ r.spec_coord | default("ABS", true) }} {{ r.spec_form | default("S", true) }} '{{ r.file }}'{% if r.month %} MONTH{% endif %}{% if r.escale %} ESCALE{% endif %}{% if r.compress %} COMPRESS{% endif %}{% if r.nonstationary %} &
    OUTPUT {{ r.tbeg }} {{ r.delt }} {{ r.delt_unit | default("HR", true) }}{% endif %}

{% elif r.type == "NESTOUT" %}
NESTOUT '{{ r.location }}' '{{ r.file }}'{% if r.nonstationary %} &
    OUTPUT {{ r.tbeg }} {{ r.delt }} {{ r.delt_unit | default("HR", true) }}{% endif %}

{% endif %}
{% endfor %}
{% endif %}

$ ============================================================================
$ 12. TEST
$ ============================================================================
{% if test_itest is defined %}
{% set has_par = test_par_file is defined %}
{% set has_s1d = test_s1d_file is defined %}
{% set has_s2d = test_s2d_file is defined %}
{% set has_par_block = has_par or has_s1d or has_s2d %}
TEST {{ test_itest }} {{ test_itrace | default(0, true) }} &
{% if test_points_mode == "IJ" %}
    POINTS IJ{% for p in test_ij_points %} {{ p.i }} {{ p.j }}{% endfor %}{% if has_par_block %} &
{% endif %}

{% elif test_points_mode == "K" %}
    POINTS{% for k in test_k_points %} {{ k }}{% endfor %}{% if has_par_block %} &
{% endif %}

{% elif test_points_mode == "XY" %}
    POINTS XY{% for p in test_xy_points %} {{ p.x }} {{ p.y }}{% endfor %}{% if has_par_block %} &
{% endif %}

{% endif %}
{% if has_par %}
    PAR '{{ test_par_file }}'{% if has_s1d or has_s2d %} &
{% endif %}

{% endif %}
{% if has_s1d %}
    S1D '{{ test_s1d_file }}'{% if has_s2d %} &
{% endif %}

{% endif %}
{% if has_s2d %}
    S2D '{{ test_s2d_file }}'
{% endif %}
{% endif %}

$ ============================================================================
$ 13. COMPUTE
$ ============================================================================
{% macro render_compute(mode, time, tbegc, deltc, deltc_unit, tendc) %}
{% if mode | default("STATIONARY", true) == "STATIONARY" %}
COMPUTE STATIONARY{% if time is defined %} {{ time }}{% endif %}
{% else %}
COMPUTE {% if tbegc is defined %}{{ tbegc }} {{ deltc }} {{ deltc_unit | default("HR", true) }}{% if tendc is defined %} {{ tendc }}{% endif %}{% endif %}
{% endif %}
{% endmacro %}
{% if compute_stages is defined %}
{% for s in compute_stages %}
{{ render_compute(s.mode, s.time, s.tbegc, s.deltc, s.deltc_unit, s.tendc) }}
{% endfor %}
{% else %}
{{ render_compute(compute_mode, compute_time, compute_tbegc, compute_deltc, compute_deltc_unit, compute_tendc) }}
{% endif %}

$ ============================================================================
$ 14. HOTFILE
$ ============================================================================
{% if hotfile_file is defined %}
HOTFILE '{{ hotfile_file }}' {{ hotfile_fmt | default("FREE", true) }}
{% endif %}

STOP
